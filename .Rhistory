collect_predictions() |>
ggplot(aes(x = touches, y = .pred)) +
geom_point(alpha = 0.7) +
geom_abline(slope = 1, intercept = 0, color = "red", linetype = "dashed") +
labs(x = "Actual Touches", y = "Predicted Touches",
title = "Best Model: Predictions vs Actual") +
theme_minimal()

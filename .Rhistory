set_engine("lm")
# Random Forest
rf_spec <- rand_forest(
mtry = tune(),
trees = 1000,
min_n = tune()
) %>%
set_engine("ranger") %>%
set_mode("regression")
# Elastic Net
glm_spec <- linear_reg(
penalty = tune(),
mixture = tune()
) %>%
set_engine("glmnet")
prep(basic_recipe)
# Create workflow set
# Combine different recipes with different models
model_set <- workflow_set(
preproc = list(
basic = basic_recipe,
pca = pca_recipe
),
models = list(
lm = lm_spec,
rf = rf_spec,
glm = glm_spec
),
cross = TRUE  # Create all combinations
)
# View the workflow set

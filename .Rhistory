model
model_data
model_data |>
arrange(player_id,approx_age) |>
group_by(player_id) |>
mutate(
delta = carries - lag(carries),
age_pair = paste(lag(approx_age), approx_age, sep = "-")
)
model_data |>
arrange(player_id,approx_age) |>
group_by(player_id) |>
mutate(
age = round(approx_age),
delta = carries - lag(carries),
age_pair = paste(lag(age), age, sep = "-")
)%>%
filter(!is.na(delta)) %>%
ungroup()
aging_curve <- delta_data %>%
group_by(age) %>%
summarise(
avg_delta = mean(delta, na.rm = TRUE),
n_observations = n(),
se = sd(delta, na.rm = TRUE) / sqrt(n()),
.groups = 'drop'
) %>%
#filter(n_observations >= 20) %>%
mutate(
cumulative_change = cumsum(avg_delta)#,
# Normalize to age 27 (typical peak)
#performance_index = cumulative_change - cumulative_change[age == 27]
)
